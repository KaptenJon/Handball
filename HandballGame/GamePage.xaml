<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HandballGame.GamePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!-- Game field -->
        <GraphicsView x:Name="GameCanvas"
                      Grid.Row="0"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <!-- Controls -->
        <Grid Grid.Row="1"
              RowDefinitions="52,52"
              ColumnDefinitions="*,*,*"
              BackgroundColor="#CC111111"
              Padding="4,4,4,6"
              ColumnSpacing="4"
              RowSpacing="4">

            <!-- Row 0 -->
            <Button Grid.Row="0" Grid.Column="0"
                    Text="PASS ↑"
                    FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#1565C0" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnPassUpClicked" />

            <Button Grid.Row="0" Grid.Column="1"
                    Text="▲ FWD"
                    FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#2E7D32" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnForwardClicked" />

            <Button Grid.Row="0" Grid.Column="2"
                    Text="SHOOT 🎯"
                    FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#B71C1C" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnShootClicked" />

            <!-- Row 1 -->
            <Button Grid.Row="1" Grid.Column="0"
                    Text="PASS ↓"
                    FontSize="14" FontAttributes="Bold"
                    BackgroundColor="#0D47A1" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnPassDownClicked" />

            <Button Grid.Row="1" Grid.Column="1"
                    Text="◄ FWD-L"
                    FontSize="13" FontAttributes="Bold"
                    BackgroundColor="#1B5E20" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnForwardLeftClicked" />

            <Button Grid.Row="1" Grid.Column="2"
                    Text="FWD-R ►"
                    FontSize="13" FontAttributes="Bold"
                    BackgroundColor="#1B5E20" TextColor="White"
                    CornerRadius="8"
                    Clicked="OnForwardRightClicked" />
        </Grid>

        <!-- Game Over Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              x:Name="GameOverOverlay"
              IsVisible="False"
              BackgroundColor="#DD000000">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="16">
                <Label x:Name="GameOverTitle"
                       Text="MATCH OVER"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="FinalScoreLabel"
                       FontSize="26"
                       TextColor="#FFD700"
                       HorizontalTextAlignment="Center" />
                <Button Text="PLAY AGAIN"
                        FontSize="20" FontAttributes="Bold"
                        BackgroundColor="#4CAF50" TextColor="White"
                        WidthRequest="220" HeightRequest="54"
                        CornerRadius="27"
                        Clicked="OnPlayAgainClicked" />
                <Button Text="MAIN MENU"
                        FontSize="20" FontAttributes="Bold"
                        BackgroundColor="#1976D2" TextColor="White"
                        WidthRequest="220" HeightRequest="54"
                        CornerRadius="27"
                        Clicked="OnMainMenuClicked" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
