<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HandballGame.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1B5E20">

    <Grid RowDefinitions="*,Auto,Auto,Auto,*" Padding="30,40">

        <!-- Title block -->
        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             Spacing="6">
            <Label Text="&#x1F93E;"
                   FontSize="90"
                   HorizontalTextAlignment="Center" />
            <Label Text="HANDBALL"
                   FontSize="50"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <Label Text="7 vs 7 Attack Game"
                   FontSize="26"
                   TextColor="#FFD700"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Play button -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="14"
                             Margin="0,36,0,0">
            <Button Text="PLAY"
                    FontSize="26"
                    FontAttributes="Bold"
                    BackgroundColor="#FFD700"
                    TextColor="#1B5E20"
                    HeightRequest="64"
                    CornerRadius="32"
                    HorizontalOptions="Fill"
                    Clicked="OnPlayClicked" />
            <Label Text="Use the buttons to control your team"
                   FontSize="13"
                   TextColor="#A5D6A7"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- How to play card -->
        <Border Grid.Row="3"
                BackgroundColor="#33000000"
                StrokeThickness="0"
                Margin="0,28,0,0"
                Padding="20,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="HOW TO PLAY"
                       FontAttributes="Bold"
                       TextColor="White"
                       FontSize="15"
                       HorizontalTextAlignment="Center" />
                <Label Text="• PASS ↑ – pass to the player nearest the goal"
                       TextColor="#C8E6C9"
                       FontSize="13" />
                <Label Text="• PASS ↓ – pass back to a player behind you"
                       TextColor="#C8E6C9"
                       FontSize="13" />
                <Label Text="• ▲ FWD / ◄ FWD-L / FWD-R ► – move ball carrier"
                       TextColor="#C8E6C9"
                       FontSize="13" />
                <Label Text="• SHOOT 🎯 – fire at the opponent's goal"
                       TextColor="#C8E6C9"
                       FontSize="13" />
                <Label Text="• Only the player with the ball can move"
                       TextColor="#C8E6C9"
                       FontSize="13" />
                <Label Text="• Passers retreat automatically – first to 7 wins!"
                       TextColor="#C8E6C9"
                       FontSize="13" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
